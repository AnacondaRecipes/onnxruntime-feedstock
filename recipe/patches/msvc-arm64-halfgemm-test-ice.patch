MSVC 14.44 ARM64 hits an internal compiler error (C1001) optimizing
test_halfgemm.cpp; build that test-only source without optimization.

--- a/cmake/onnxruntime_unittests.cmake
+++ b/cmake/onnxruntime_unittests.cmake
@@ -2259,6 +2259,10 @@
       "${TEST_SRC_DIR}/mlas/unittest/*.cpp"
     )
     onnxruntime_add_executable(onnxruntime_mlas_test ${onnxruntime_mlas_test_src})
+    if(MSVC AND onnxruntime_target_platform STREQUAL "ARM64")
+      set_source_files_properties("${TEST_SRC_DIR}/mlas/unittest/test_halfgemm.cpp"
+                                  PROPERTIES COMPILE_OPTIONS "/Od")
+    endif()
     if(MSVC)
       target_compile_options(onnxruntime_mlas_test PRIVATE "$<$<COMPILE_LANGUAGE:CUDA>:SHELL:--compiler-options /wd26409>"
                   "$<$<NOT:$<COMPILE_LANGUAGE:CUDA>>:/wd26409>")
